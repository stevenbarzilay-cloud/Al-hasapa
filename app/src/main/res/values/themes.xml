<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only. The cream window background avoids a white flash before the hub paints. -->
    <style name="Theme.AlHasapa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
