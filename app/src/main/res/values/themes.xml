<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only. The cream window background avoids a white flash before the hub paints. -->
    <style name="Theme.AlHasapa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- The system splash (a static cream screen with the three cats) shows for the first instants of a cold
         start. The in-app animated splash (ui/SplashScreen.kt) takes over right after it, in the same spot. -->
    <style name="Theme.AlHasapa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AlHasapa</item>
    </style>
</resources>
