<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The phone as the TV's keyboard: Android 17 asks before an app reaches devices on the home network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".CouchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlHasapa"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AlHasapa.Starting"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".accounts.AccountsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|fontScale"
            android:theme="@style/Theme.AlHasapa" />

        <!-- The isolated player: landscape only, because the phone sits sideways while cast to the TV. -->
        <!-- Android 16+ ignores a fixed orientation on LARGE screens (tablets, foldables). This is a phone-only app (a Pixel 8),
             where it is honored; PlayerActivity also requests the orientation in code. -->
        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            tools:ignore="DiscouragedApi"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|fontScale"
            android:theme="@style/Theme.AlHasapa" />

        <!-- Keyboard mode: the phone as the TV app's keyboard. The phone's own keyboard stays up while it is open. -->
        <activity
            android:name=".keyboard.KeyboardModeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|fontScale"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/Theme.AlHasapa" />

        <!-- The share target: "Share" in any game or app, choose this one, and the result lands on tonight's page. -->
        <activity
            android:name=".results.ShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_target_label"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AlHasapa">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
