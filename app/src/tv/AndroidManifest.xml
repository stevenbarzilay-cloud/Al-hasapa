<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A TV has no touchscreen, and is not necessarily "leanback"-certified either (a sideloaded APK does not need to be). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- While a phone is the TV's keyboard and touchpad, the TV's Wi-Fi is asked not to doze between packets (see WifiLatency):
         Android files the Wi-Fi lock under this permission. Nothing is kept awake when the app is not in front. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application android:banner="@drawable/tv_banner">
        <!-- The Android TV launcher shows apps that declare LEANBACK_LAUNCHER. -->
        <activity android:name=".MainActivity" android:exported="true" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
