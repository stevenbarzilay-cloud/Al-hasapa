<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Solo (1.11): "רוני כבר שיחק היום ב-Bandle — מה איתך?" with the app closed. Asked the first time a game is played alone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The relay's look every quarter of an hour (SoloJob) is kept when the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- The look at the relay, by itself (a job: Android runs it when it suits the battery, only with a network). -->
        <service
            android:name=".remote.SoloJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 1.11.1: a photo of a computer's screen for a result. The camera app writes it here (the app itself never uses the camera);
             it is read on the phone and deleted. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/photo_paths" />
        </provider>
        <!-- Google Play services downloads the text model with the app, so the first photo is read at once. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr" />
        <!-- 2.0: "הספות שלי": the home couch, friends' couches, visits, and the app's install link for a friend. -->
        <activity
            android:name=".couches.CouchesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AlHasapa" />
        <!-- Long press on the app's icon: "מקלדת לטלוויזיה" goes straight to keyboard mode. -->
        <activity android:name=".MainActivity" android:exported="true" tools:node="merge">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
